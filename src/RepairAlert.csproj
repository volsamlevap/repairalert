<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RepairAlert</AssemblyName>
    <RootNamespace>RepairAlert</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>2.43.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\app-icon.png" />
    <Resource Include="assets\paperclip.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- QR-код для загрузки файлов с телефона (MIT, без System.Drawing) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
